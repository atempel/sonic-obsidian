{
  "name": "sonic-obsidian",
  "version": "0.5.0",
  "private": true,
  "description": "Visualizador de áudio para Windows: Electron + Butterchurn com captura do áudio do sistema por loopback.",
  "author": "Alexandre Tempel",
  "license": "MIT",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "typecheck": "tsc -p tsconfig.node.json --noEmit && tsc -p tsconfig.web.json --noEmit",
    "test:ui": "node tests/headless/run.cjs",
    "sim:beat": "node tests/sim/beat-sim.cjs",
    "dist:win": "electron-vite build && electron-builder --win --dir --publish never",
    "dist:release": "electron-vite build && electron-builder --win --publish never",
    "site:vendor": "node scripts/site-vendor.mjs"
  },
  "dependencies": {
    "@fontsource/jetbrains-mono": "5.3.0",
    "@fontsource/space-grotesk": "5.3.0",
    "butterchurn": "3.0.0-beta.5",
    "butterchurn-presets": "3.0.0-beta.4",
    "eel-wasm": "0.0.16",
    "hlslparser-js": "0.1.1",
    "milkdrop-preset-utils": "0.2.1",
    "preact": "11.0.2"
  },
  "devDependencies": {
    "@types/node": "26.6.6",
    "butterchurn-presets-v2-site": "npm:butterchurn-presets@2.4.7",
    "butterchurn-v2-site": "npm:butterchurn@2.6.7",
    "electron": "45.2.3",
    "electron-builder": "26.18.0",
    "electron-vite": "6.0.0",
    "typescript": "6.0.3",
    "vite": "8.3.6"
  }
}
